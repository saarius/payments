[Unit]
Description=Backroad Bum private test-mode Payments transport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/var/lib/trialrun/workspace/repos/payments
Environment=NODE_ENV=production
EnvironmentFile=/etc/backroadbum/stripe.env
ExecStart=/opt/node/bin/node --import tsx ops/backroadbum/runtime.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/backroadbum/payments
MemoryMax=256M

[Install]
WantedBy=multi-user.target
